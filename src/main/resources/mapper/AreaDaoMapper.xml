<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.o2o.dao.AreaDao">
    <!-- namespace对应Mapper接口的全限定名 -->

    <select id="getList" resultType="com.o2o.entity.Area">
        select area_id, area_name, priority,create_time,last_edit_time from tb_area
    </select>

    <insert id="batchInsertArea" useGeneratedKeys="true" keyProperty="areaId">
        INSERT INTO tb_area (
                area_name, priority, create_time, last_edit_time
        ) VALUES
        <foreach collection="areaList" item="area" separator=",">
            (
            #{area.areaName},
            #{area.priority},
            NOW(),
            NOW()
            )
        </foreach>
    </insert>

</mapper>