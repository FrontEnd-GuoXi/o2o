<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.o2o.dao.Recommend">
    <resultMap id="shopMap" type="com.o2o.entity.Shop">
        <id column="shop_id" property="shopId" />
        <result column="shop_name" property="shopName" />
        <result column="shop_desc" property="shopDesc" />
        <result column="shop_img" property="shopImg" />
        <association property="shopCategory" javaType="com.o2o.entity.ShopCategory" >
            <id column="shop_category_id" property="shopCategoryId" />
            <result column="shop_category_name" property="shopCategoryName" />
        </association>
    </resultMap>

    <select id="recommendByRating" resultMap="shopMap">
        SELECT
               ts.shop_id, ts.shop_name, ts.shop_desc, ts.shop_img,
               ts.shop_category_id, tsc.shop_category_name
        FROM tb_shop ts
        LEFT JOIN tb_shop_category tsc ON ts.shop_category_id = tsc.shop_category_id
    </select>
</mapper>